{
  "name": "deterministic-chibi-battle-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "description": "Standalone deterministic 2D chibi squad battle royale prototype",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate.mjs && npm test",
    "build": "electron-builder --dir"
  },
  "dependencies": {
    "pixi.js": "8.14.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.doddler.redzonechibi",
    "productName": "Red Zone Chibi Prototype",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "README.md"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "dir",
      "category": "Game"
    }
  },
  "allowScripts": {
    "electron@31.2.0": true
  }
}
